local function refreshFFToggle()
    if FastFlagsActivos then
        ffToggleBtn.Text = "ON"
        ffToggleBtn.BackgroundColor3 = Color3.fromRGB(70, 180, 90)
    else
        ffToggleBtn.Text = "OFF"
        ffToggleBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    end
end

ffToggleBtn.MouseButton1Click:Connect(function()
    FastFlagsActivos = not FastFlagsActivos
    refreshFFToggle()
    if FastFlagsActivos then
        aplicarFastFlags()
        showNotif("AHK", "Fast Flags enabled")
    else
        quitarFastFlags()
        showNotif("AHK", "Fast Flags disabled")
    end
end)

