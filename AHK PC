local uiAbierta = false

local function toggleUI()
    uiAbierta = not uiAbierta
    mainPanel.Visible = uiAbierta
    if uiAbierta then
        mainPanel.Size = UDim2.new(0, 0, 0, 0)
        TweenService:Create(mainPanel, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, PANEL_W, 0, PANEL_H)
        }):Play()
    end
end

floatBtn.MouseButton1Click:Connect(toggleUI)

local function executeJump()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    pcall(function()
        for _, v in pairs(hrp:GetChildren()) do
            if v:IsA("BodyVelocity") and v.Name == "AHKJump" then v:Destroy() end
        end
        local bv = Instance.new("BodyVelocity")
        bv.Name = "AHKJump"
        bv.MaxForce = Vector3.new(0, 50000, 0)
        bv.Velocity = Vector3.new(0, 1000, 0)
        bv.Parent = hrp
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
        task.delay(0.05, function() pcall(function() if hum and hum.Parent then hum:ChangeState(Enum.HumanoidStateType.Freefall) end end) end)
        task.delay(0.15, function() if bv then bv:Destroy() end end)
    end)
end

local function executeSanguineBoost()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChild("Humanoid")
    if not hrp or not hum then return end
    local dir = camera.CFrame.LookVector
    hum.PlatformStand = true
    local att = Instance.new("Attachment", hrp)
    local lv = Instance.new("LinearVelocity", hrp)
    lv.MaxForce = 9999999
    lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    lv.VectorVelocity = dir * 500
    lv.Attachment0 = att
    task.delay(0.30, function()
        if lv then lv:Destroy() end
        if att then att:Destroy() end
        if hum then hum.PlatformStand = false end
    end)
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end

    if input.KeyCode == Enum.KeyCode.RightAlt then
        toggleUI()
    elseif input.KeyCode == Enum.KeyCode.CapsLock then
        _G_SilentAimSkill = not _G_SilentAimSkill
        showNotif("AHK", "Silent Aim: " .. (_G_SilentAimSkill and "ON" or "OFF"))
    elseif input.KeyCode == Enum.KeyCode.G then
        executeJump()
    elseif input.KeyCode == Enum.KeyCode.LeftAlt then
        executeSanguineBoost()
    end
end)

