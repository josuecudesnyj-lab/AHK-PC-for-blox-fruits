local boostConns = {}
local function hookBoostAnim(key, cfg)
    if boostConns[key] then boostConns[key]:Disconnect(); boostConns[key] = nil end
    if boostConns[key.."_res"] then boostConns[key.."_res"]:Disconnect(); boostConns[key.."_res"] = nil end
    local function attach(char)
        local hum = char:WaitForChild("Humanoid", 5)
        if not hum then return end
        local conn = hum.AnimationPlayed:Connect(function(track)
            if not cfg.Enabled then return end
            local anim = track.Animation
            local id = anim and tostring(anim.AnimationId):match("%d+")
            local name = anim and anim.Name or ""
            local match = false
            for _, aid in ipairs(cfg.AnimIDs) do if id == aid then match = true; break end end
            if cfg.AnimName ~= "" and name == cfg.AnimName then match = true end
            if not match then return end
            local start = tick()
            track.Stopped:Connect(function()
                if not cfg.Enabled then return end
                if (tick() - start) >= cfg.MinCharge then task.spawn(function() doConfigBoost(cfg) end) end
            end)
        end)
        boostConns[key] = conn
    end
    if LocalPlayer.Character then attach(LocalPlayer.Character) end
    boostConns[key.."_res"] = LocalPlayer.CharacterAdded:Connect(attach)
end

local function unhookBoostAnim(key)
    if boostConns[key] then boostConns[key]:Disconnect(); boostConns[key] = nil end
    if boostConns[key.."_res"] then boostConns[key.."_res"]:Disconnect(); boostConns[key.."_res"] = nil end
end

