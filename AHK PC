local function selectTab(tab)
    playTabSound()
    
    for t, data in pairs(tabsData) do
        TweenService:Create(t, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(45, 45, 55), BackgroundTransparency = 0.5, TextColor3 = Color3.fromRGB(220, 220, 230) }):Play()
        TweenService:Create(data.bar, TweenInfo.new(0.2), { BackgroundTransparency = 1 }):Play()
        TweenService:Create(data.dot, TweenInfo.new(0.2), { BackgroundTransparency = 1, Size = UDim2.new(0, 0, 0, 0) }):Play()
    end
    
    TweenService:Create(tab, TweenInfo.new(0.15), { BackgroundColor3 = currentTheme.Main, BackgroundTransparency = 0.2, TextColor3 = Color3.fromRGB(255, 255, 255) }):Play()
    TweenService:Create(tabsData[tab].bar, TweenInfo.new(0.2), { BackgroundTransparency = 0 }):Play()
    TweenService:Create(tabsData[tab].dot, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { BackgroundTransparency = 0, Size = UDim2.new(0, 6, 0, 6), Position = UDim2.new(1, -11, 0.5, -3) }):Play()
    
    centerTitle.Text = tabsData[tab].titulo
    for t, s in pairs(scrolls) do s.Visible = (t == tab) end
    activeTab = tab
    
    local ripple = Instance.new("Frame")
    ripple.Size = UDim2.new(0, 0, 0, 0)
    ripple.Position = UDim2.new(0.5, 0, 0.5, 0)
    ripple.AnchorPoint = Vector2.new(0.5, 0.5)
