local function shakeKey()
    local orig = keyPanel.Position
    for i = 1, 4 do
        local dir = (i % 2 == 0) and 1 or -1
        keyPanel.Position = orig + UDim2.new(0.015 * dir, 0, 0, 0)
        task.wait(0.05)
    end
    keyPanel.Position = orig
end

