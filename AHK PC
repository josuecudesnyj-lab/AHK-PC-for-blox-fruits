local frameCount = 0
local lastTime = tick()

RunService.RenderStepped:Connect(function()
    frameCount = frameCount + 1
end)

task.spawn(function()
    while screenGui and screenGui.Parent do
        task.wait(1)
        local now = tick()
        local elapsed = now - lastTime
        if elapsed > 0 then
            currentFPS = math.floor(frameCount / elapsed)
        end
        frameCount = 0
        lastTime = now
        pcall(function()
            currentPing = math.floor(LocalPlayer:GetNetworkPing() * 1000)
        end)
        overlayText.Text = "FPS: " .. currentFPS .. " | Ping: " .. currentPing .. "ms"
    end
end)

