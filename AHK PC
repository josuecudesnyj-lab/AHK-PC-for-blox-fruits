task.spawn(function()
    while screenGui and screenGui.Parent do
        task.wait(1)
        local now = tick()
        local elapsed = now - lastTime
        if elapsed > 0 then currentFPS = math.floor(frameCount / elapsed) end
        frameCount = 0
