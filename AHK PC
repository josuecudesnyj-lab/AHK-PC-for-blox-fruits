-- STATS EN TIEMPO REAL
local function getLevel()
    local lvl = 0
    pcall(function()
        if LocalPlayer:FindFirstChild("Data") and LocalPlayer.Data:FindFirstChild("Level") then
            lvl = LocalPlayer.Data.Level.Value
        end
    end)
    return lvl
end

local function getBounty()
    local bounty = 0
    pcall(function()
        if LocalPlayer:FindFirstChild("leaderstats") then
            for _, v in pairs(LocalPlayer.leaderstats:GetChildren()) do
                if v.Name:lower():find("bounty") or v.Name:lower():find("beli") then
                    bounty = v.Value
                end
            end
        end
    end)
    return bounty
end

task.spawn(function()
    while screenGui and screenGui.Parent do
        task.wait(0.5)
        pcall(function()
            levelLabel.Text = tostring(getLevel())
            local bountyActual = getBounty()
            bountyLabel.Text = tostring(bountyActual)
            conexionLabel.Text = tostring(currentPing) .. " ms"
            fpsLabel.Text = tostring(currentFPS)
            bountyGanadoLabel.Text = tostring(stats.bountyGanado)
            muertesLabel.Text = tostring(stats.muertes)
            killsLabel.Text = tostring(stats.kills)

            if bountyActual > ultimoBounty then
                stats.bountyGanado = stats.bountyGanado + (bountyActual - ultimoBounty)
            end
            ultimoBounty = bountyActual
        end)
    end
end)

