    applyFont(t, Enum.FontWeight.Bold)

    local tx = Instance.new("TextLabel")
    tx.Size = UDim2.new(1, -16, 0, 16)
    tx.Position = UDim2.new(0, 10, 0, 26)
    tx.BackgroundTransparency = 1
    tx.Text = texto
    tx.TextColor3 = Color3.fromRGB(200, 200, 210)
    tx.TextSize = 8
    tx.Font = Enum.Font.Gotham
    tx.TextXAlignment = Enum.TextXAlignment.Left
    tx.TextTruncate = Enum.TextTruncate.AtEnd
    tx.ZIndex = 32
    tx.Parent = notif
    applyFont(tx, Enum.FontWeight.Regular)

    notif.Position = UDim2.new(0, 300, 0, 0)
    TweenService:Create(notif, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 0, 0, 0)
    }):Play()

    task.delay(4, function()
        TweenService:Create(notif, TweenInfo.new(0.3), { Position = UDim2.new(0, 300, 0, 0) }):Play()
        task.wait(0.35)
        notif:Destroy()
    end)
end

