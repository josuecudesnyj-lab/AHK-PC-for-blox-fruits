local function setFF(name, value)
    pcall(function()
        if setfflag then setfflag(name, tostring(value)) end
    end)
end

local function aplicarFastFlags()
    for name, value in pairs(FastFlagsList) do setFF(name, value) end
end

local function quitarFastFlags()
    pcall(function()
        if setfflag then
            setfflag("DFIntTaskSchedulerTargetFps", "60")
            setfflag("FIntRakNetLoopMs", "20")
            setfflag("DFIntS2PhysicsSenderRate", "60")
            setfflag("FFlagDisablePostFx", "false")
        end
    end)
end

