    dot.BackgroundTransparency = 1
    dot.BorderSizePixel = 0
    dot.ZIndex = 24
    dot.Parent = btn
    Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

    btn.MouseEnter:Connect(function()
        if activeTab ~= btn then TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = Color3.fromRGB(60, 60, 72) }):Play() end
    end)
