local function loadSavedKey()
    local ok, result = pcall(function()
        if readfile and isfile and isfile("luaC_key.json") then
            local data = HttpService:JSONDecode(readfile("luaC_key.json"))
            if data and data.key and data.expire and os.time() < data.expire then return data.key end
        end
        return nil
    end)
    if ok and result then return result end
    local memData = nil
    pcall(function()
        if getgenv then memData = getgenv()[KEY_MEMORY_KEY] end
        if not memData and _G then memData = _G[KEY_MEMORY_KEY] end
