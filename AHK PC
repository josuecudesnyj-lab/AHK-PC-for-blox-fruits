-- Función para crear botones con toggle visual
local toggleRefreshes = {}
local function createToggleBtn(parent, labelText, getter, setter, yPos)
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, -12, 0, 30)
    frame.Position = UDim2.new(0, 6, 0, yPos)
    frame.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    frame.BackgroundTransparency = 0.5
    frame.BorderSizePixel = 0
    frame.ZIndex = 22
    frame.Parent = parent
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = frame
    local s = Instance.new("UIStroke")
    s.Thickness = 1.2
    s.Color = Color3.fromRGB(0, 0, 0)
    s.Transparency = 0.3
    s.Parent = frame

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0.6, 0, 1, 0)
    lbl.Position = UDim2.new(0, 10, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = labelText
    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbl.TextSize = 11
    lbl.Font = Enum.Font.GothamBold
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 23
    lbl.Parent = frame
    applyFont(lbl, Enum.FontWeight.Bold)

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 50, 0, 22)
    btn.Position = UDim2.new(1, -60, 0.5, -11)
    btn.BackgroundColor3 = getter() and Color3.fromRGB(70, 180, 90) or Color3.fromRGB(50, 50, 60)
    btn.Text = getter() and "ON" or "OFF"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 10
    btn.Font = Enum.Font.GothamBold
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false
    btn.ZIndex = 23
    btn.Parent = frame
    applyFont(btn, Enum.FontWeight.Bold)
    local bc = Instance.new("UICorner")
    bc.CornerRadius = UDim.new(0, 4)
    bc.Parent = btn

    local function refresh()
        if getter() then
            btn.BackgroundColor3 = Color3.fromRGB(70, 180, 90)
            btn.Text = "ON"
        else
            btn.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
            btn.Text = "OFF"
        end
    end
    table.insert(toggleRefreshes, refresh)

    btn.MouseButton1Click:Connect(function()
        setter(not getter())
        refresh()
    end)

    return btn, frame
end

