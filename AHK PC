-- SELECT TAB
local function selectTab(tab)
    for t, _ in pairs(tabsData) do
        TweenService:Create(t, TweenInfo.new(0.15), {
            BackgroundColor3 = Color3.fromRGB(45, 45, 55),
            BackgroundTransparency = 0.4,
            TextColor3 = Color3.fromRGB(220, 220, 230)
        }):Play()
    end
    TweenService:Create(tab, TweenInfo.new(0.15), {
        BackgroundColor3 = COLOR_GRIS,
        BackgroundTransparency = 0.2,
        TextColor3 = Color3.fromRGB(255, 255, 255)
    }):Play()

    centerTitle.Text = tabsData[tab].titulo

    if tab == tabMisc then
        centerTextLabel.Visible = false
        miscContainer.Visible = true
    else
        centerTextLabel.Visible = true
        miscContainer.Visible = false
        centerTextLabel.Text = tabsData[tab].contenido
    end

    activeTab = tab
end

for tab, _ in pairs(tabsData) do
    tab.MouseButton1Click:Connect(function()
        selectTab(tab)
    end)
end

selectTab(tabCombat)

-- ABRIR / CERRAR UI
local uiAbierta = false

local function toggleUI()
    uiAbierta = not uiAbierta
    mainPanel.Visible = uiAbierta
    if uiAbierta then
        mainPanel.Size = UDim2.new(0, 0, 0, 0)
        TweenService:Create(mainPanel, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, PANEL_W, 0, PANEL_H)
        }):Play()
    end
end

floatBtn.MouseButton1Click:Connect(toggleUI)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.LeftAlt then
        toggleUI()
    end
end)

